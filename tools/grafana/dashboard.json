    },
    "overrides": []
   },
   "description": "Liegt der Ladestand unter der Plan-Linie, verbraucht die Fahrt mehr als geplant."
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Verbrauch (30-s-Mittel)",
   "gridPos": {
    "x": 0,
    "y": 26,
    "w": 12,
    "h": 6
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "jolt-pg"
   },
   "targets": [
    {
     "rawSql": "\nSELECT date_bin('30 seconds', time, TIMESTAMP '2000-01-01') AS time,\n       round((avg(power_kw) / avg(speed_kmh) * 100)::numeric, 1) AS \"kWh/100 km\"\nFROM grafana_points\nWHERE session_id = ${session} AND speed_kmh IS NOT NULL AND power_kw IS NOT NULL\nGROUP BY 1 HAVING avg(speed_kmh) > 15 ORDER BY 1",
     "format": "time_series",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "jolt-pg"
     },
     "refId": "A",
     "editorMode": "code"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "auto",
      "spanNulls": 600000
     },
     "unit": "none"
    },
    "overrides": []
   },
   "description": "Mittlere Leistung durch mittleres Tempo je 30 s, nur über 15 km/h. Negative Werte sind Rekuperation."
  },
