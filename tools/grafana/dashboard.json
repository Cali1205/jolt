{
 "uid": "jolt-trips",
 "title": "jolt Fahrten",
 "tags": [
  "jolt"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "version": 1,
 "refresh": "",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "session",
    "label": "Fahrt",
    "type": "query",
    "datasource": {
     "type": "grafana-postgresql-datasource",
     "uid": "jolt-pg"
    },
    "query": "SELECT id AS __value, '#' || id || '  ' || to_char(time, 'DD.MM. HH24:MI') || '  ' || coalesce(round(km_odometer)::text, '?') || ' km' AS __text FROM grafana_sessions ORDER BY id DESC",
    "definition": "grafana_sessions",
    "refresh": 2,
    "sort": 0,
    "includeAll": false,
    "multi": false
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "table",
   "title": "Fahrten (ID anklicken: Fahrt unten anzeigen)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 14,
    "h": 10
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "jolt-pg"
   },
   "targets": [
    {
     "rawSql": "\nSELECT id, time AS \"Start\", round((extract(epoch FROM duration) / 60)::numeric) AS \"Min\",\n       round(km_odometer::numeric) AS \"km\", round(net_kwh::numeric, 2) AS \"kWh netto\",\n       round(kwh_per_100km::numeric, 1) AS \"kWh/100 km\",\n       round(soc_start::numeric, 1) AS \"SoC Start\", round(soc_end::numeric, 1) AS \"SoC Ende\",\n       round(outside_c::numeric, 1) AS \"Außen °C\", round(speed_max_kmh::numeric) AS \"vmax\",\n       round(aux_avg_kw::numeric, 2) AS \"Neben kW\", points AS \"Punkte\",\n       (extract(epoch FROM time) * 1000)::bigint AS von,\n       (extract(epoch FROM coalesce(last_point, time)) * 1000 + 60000)::bigint AS bis\nFROM grafana_sessions ORDER BY id DESC LIMIT 200",
     "format": "table",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "jolt-pg"
     },
     "refId": "A",
     "editorMode": "code"
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "id"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Fahrt anzeigen",
          "url": "/d/jolt-trips?orgId=1&var-session=${__data.fields.id}&from=${__data.fields.von}&to=${__data.fields.bis}"
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(von|bis)$"
      },
      "properties": [
       {
        "id": "custom.hidden",
        "value": true
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "kWh/100 km"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "yellow",
           "value": 20
          },
          {
           "color": "red",
           "value": 24
          }
         ]
        }
       }
      ]
     }
    ]
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Alle Fahrten",
   "gridPos": {
    "x": 14,
    "y": 0,
    "w": 10,
    "h": 4
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "jolt-pg"
   },
   "targets": [
    {
     "rawSql": "\nSELECT count(*) AS \"Fahrten\", round(sum(km_odometer)::numeric) AS \"km\",\n       round((100 * sum(net_kwh) FILTER (WHERE km_odometer >= 3)\n              / nullif(sum(km_odometer) FILTER (WHERE km_odometer >= 3), 0))::numeric, 1)\n         AS \"Ø kWh/100 km\"\nFROM grafana_sessions",
     "format": "table",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "jolt-pg"
     },
     "refId": "A",
     "editorMode": "code"
    }
   ],
   "options": {
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value_and_name",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "description": "Ø nur über Fahrten ab 3 km (der Kilometerzähler ist ganzzahlig)."
  },
  {
   "id": 3,
   "type": "barchart",
   "title": "Verbrauch je Fahrt (letzte 40, ab 3 km) und Außentemperatur",
   "gridPos": {
    "x": 14,
    "y": 4,
    "w": 10,
    "h": 6
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "jolt-pg"
   },
   "targets": [
    {
     "rawSql": "\nSELECT '#' || id AS \"Fahrt\", round(kwh_per_100km::numeric, 1) AS \"kWh/100 km\",\n       round(outside_c::numeric, 1) AS \"Außen °C\"\nFROM (SELECT * FROM grafana_sessions WHERE kwh_per_100km IS NOT NULL\n      ORDER BY id DESC LIMIT 40) t ORDER BY id",
     "format": "table",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "jolt-pg"
     },
     "refId": "A",
     "editorMode": "code"
    }
   ],
   "options": {
    "xField": "Fahrt",
    "orientation": "vertical",
    "showValue": "never",
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "xTickLabelRotation": -45,
    "tooltip": {
     "mode": "multi"
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 70
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Außen °C"
      },
      "properties": [
       {
        "id": "custom.axisPlacement",
        "value": "right"
       },
       {
        "id": "unit",
        "value": "celsius"
       }
      ]
     }
    ]
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Fahrt ${session}",
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 24,
    "h": 4
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "jolt-pg"
   },
   "targets": [
    {
     "rawSql": "\nSELECT round(km_odometer::numeric) AS \"km\", round(kwh_per_100km::numeric, 1) AS \"kWh/100 km\",\n       round(net_kwh::numeric, 2) AS \"kWh netto\", round((soc_start - soc_end)::numeric, 1) AS \"SoC verbraucht\",\n       round(aux_avg_kw::numeric, 2) AS \"Ø Neben kW\", round(speed_max_kmh::numeric) AS \"vmax km/h\",\n       round(outside_c::numeric, 1) AS \"Außen °C\",\n       round((extract(epoch FROM duration) / 60)::numeric) AS \"Dauer min\"\nFROM grafana_sessions WHERE id = ${session}",
     "format": "table",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "jolt-pg"
     },
     "refId": "A",
     "editorMode": "code"
    }
   ],
   "options": {
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value_and_name",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "geomap",
   "title": "Route (Farbe = Tempo)",
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 12
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "jolt-pg"
   },
   "targets": [
    {
     "rawSql": "SELECT lat, lon, speed_kmh, time FROM grafana_points WHERE session_id = ${session} AND lat IS NOT NULL ORDER BY time",
     "format": "table",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "jolt-pg"
     },
     "refId": "A",
     "editorMode": "code"
    }
   ],
   "options": {
    "view": {
     "id": "fit",
     "allLayers": true,
     "zoom": 12
    },
    "controls": {
     "showZoom": true,
     "mouseWheelZoom": true
    },
    "basemap": {
     "type": "osm-standard",
     "name": "Basemap"
    },
    "layers": [
     {
      "type": "markers",
      "name": "Route",
      "location": {
       "mode": "coords",
       "latitude": "lat",
       "longitude": "lon"
      },
      "config": {
       "showLegend": true,
       "style": {
        "size": {
         "fixed": 4,
         "min": 2,
         "max": 6
        },
        "color": {
         "field": "speed_kmh",
         "fixed": "dark-green"
        },
        "opacity": 0.9,
        "symbol": {
         "mode": "fixed",
         "fixed": "img/icons/marker/circle.svg"
        }
       }
      }
     }
    ]
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "continuous-GrYlRd"
     },
     "min": 0,
     "max": 120,
     "unit": "velocitykmh"
    },
    "overrides": []
   }
  },
  {
