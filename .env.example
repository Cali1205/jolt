# Kopie als .env anlegen und ausfuellen.

# Passwort der Postgres-Datenbank (frei waehlbar, aber nicht leer)
DB_PASSWORD=

# Passwort fuer den Zugang zur App. Leer = kein Login (nur im Heimnetz!)
APP_PASSWORT=

# openrouteservice: Route + Hoehenprofil. Kostenlos, 2500 Anfragen/Tag.
# https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Open Charge Map: nur fuer den Ladesaeulen-Import ausserhalb Deutschlands.
# https://openchargemap.org/site/profile/applications
OCM_API_KEY=

# Benachrichtigungen aufs Telefon (Web Push). Erzeugen: tools/push_schluessel.py
# Ohne diese Schluessel ist die Funktion aus - die Aenderung steht dann nur in
# der offenen Ansicht. Der private Schluessel gehoert ausschliesslich hierher.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# Adresse, unter der der Push-Dienst jemanden erreicht, wenn dieser Server
# auffaellt. mailto: oder https:
VAPID_SUBJECT=

# Nur setzen, wenn ein Reverse Proxy davor steht (kommagetrennte IPs)
TRUSTED_PROXIES=

# Interaktive API-Doku unter /api/docs einschalten (nur zum Entwickeln)
ENABLE_API_DOCS=
