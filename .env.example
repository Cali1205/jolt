# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
# Long random values: openssl rand -base64 24

# --- Required ---------------------------------------------------------------

# Password of the Postgres database. Any value, not empty.
DB_PASSWORD=

# Login password of the app. Empty means NO login - only acceptable in a
# network nobody else can reach. Use 20 characters or more once it is public.
APP_PASSWORT=

# openrouteservice: routes and elevation profiles. The free plan is enough.
# https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# --- Where it runs ----------------------------------------------------------

# Database and nightly backups. Default: ./data next to docker-compose.yml.
JOLT_DATA=

# Address and port the app is published on. Default 127.0.0.1:8322, i.e. only
# on this host. Docker publishes ports past the host firewall: 0.0.0.0 would
# expose jolt without HTTPS. Use a LAN or VPN address if needed.
JOLT_BIND=
JOLT_PORT=

# Reverse proxy or tunnel in front of jolt that may set X-Forwarded-For.
# Addresses or networks, comma separated, e.g. 172.24.0.0/16 for the compose
# network (docker network inspect jolt_default).
TRUSTED_PROXIES=

# Cloudflare Tunnel token, only for docker-compose.tunnel.yml (README,
# "HTTPS with a Cloudflare Tunnel").
TUNNEL_TOKEN=

# Time zone of the backup schedule and Watchtower.
TZ=Europe/Berlin

# Days of nightly database dumps to keep (default 14).
BACKUP_KEEP_DAYS=

# --- Optional services ------------------------------------------------------

# TomTom: alternative routes and traffic. Free key at developer.tomtom.com.
# Without it planning works as well; nothing from TomTom is stored.
TOMTOM_API_KEY=

# Open Charge Map: only for importing chargers outside Germany.
# https://openchargemap.org/site/profile/applications
OCM_API_KEY=

# Push notifications to the phone (Web Push). Generate all three with
#   docker compose run --rm --no-deps jolt-app python tools/push_keyname.py
# Without them the feature is off. The private key belongs only here.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# How the push service can reach the operator: mailto:you@example.org
VAPID_SUBJECT=

# --- Limits (defaults are fine) ---------------------------------------------

# Requests per minute and client address, and failed logins per 15 minutes.
RATE_LIMIT_PER_MIN=
LOGIN_LIMIT_PER_15MIN=

# --- Automatic updates (optional) -------------------------------------------

# Uncomment to start Watchtower, which pulls new images and restarts jolt-app
# (never during a recorded trip). It needs the Docker socket.
#COMPOSE_PROFILES=autoupdate
#WATCHTOWER_SCHEDULE=0 */10 * * * *
#WATCHTOWER_HTTP_API_ENDPOINTS=update
#WATCHTOWER_HTTP_API_TOKEN=

# --- Development -------------------------------------------------------------

# 1 enables the interactive API documentation under /api/docs.
ENABLE_API_DOCS=
